root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{md,yml,yaml,json,csproj,config}]
indent_size = 2

[*.{aspx,ascx,master}]
indent_style = space
indent_size = 4

[*.{css,js}]
indent_size = 2

[*.sql]
indent_size = 4
